
import numpy as np
import tensorflow as tf

# Reproducibility
np.random.seed(42)
tf.random.set_seed(42)

# Generate sample light-level data
# Input values are normalized between 0 and 1.
X = np.linspace(0.0, 1.0, 1000, dtype=np.float32).reshape(-1, 1)

# Labels: 0 = Dark, 1 = Normal, 2 = Bright
y = np.where(X[:, 0] < 0.33, 0,
    np.where(X[:, 0] < 0.66, 1, 2)).astype(np.int32)

# Build a small neural network
model = tf.keras.Sequential([
    tf.keras.Input(shape=(1,)),
    tf.keras.layers.Dense(8, activation="relu"),
    tf.keras.layers.Dense(3, activation="softmax")
])

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

# Train the model
model.fit(X, y, epochs=30, batch_size=32, verbose=1)

# Save the trained model as TensorFlow Lite
converter = tf.lite.TFLiteConverter.from_keras_model(model)
tflite_model = converter.convert()

with open("light_classifier.tflite", "wb") as f:
    f.write(tflite_model)

print("TFLite model created successfully!")
print("Model size:", len(tflite_model), "bytes")

# Test predictions in Python
for value in [0.20, 0.50, 0.80]:
    prediction = model.predict(
        np.array([[value]], dtype=np.float32), verbose=0
    )[0]
    print(value, "->", ["Dark", "Normal", "Bright"][np.argmax(prediction)])


  
# Convert the .tflite file into model_data.h
with open("light_classifier.tflite", "rb") as f:
    model_bytes = f.read()

with open("model_data.h", "w") as f:
    f.write("#pragma once\n")
    f.write("#include <cstdint>\n\n")
    f.write("alignas(16) const unsigned char g_model[] = {\n")

    for i in range(0, len(model_bytes), 12):
        chunk = model_bytes[i:i + 12]
        f.write("  " + ", ".join(f"0x{b:02x}" for b in chunk) + ",\n")

    f.write("};\n")
    f.write(f"const unsigned int g_model_len = {len(model_bytes)};\n")

print("Created model_data.h")
